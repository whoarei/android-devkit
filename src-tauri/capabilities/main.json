{
  "identifier": "main",
  "description": "Local workbench only; all system actions validated by Rust",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-workspace-snapshot",
    "allow-task-list",
    "allow-environment-scan",
    "allow-settings-save",
    "allow-catalog-refresh",
    "allow-sdk-sites-status",
    "allow-plan-create",
    "allow-task-submit",
    "allow-task-cancel",
    "allow-task-retry",
    "allow-file-choose",
    "allow-artifact-save",
    "allow-artifact-copy",
    "allow-apk-prepare",
    "allow-log-read",
    "allow-window-action",
    "allow-window-state",
    "allow-window-regions",
    "allow-close-resolve",
    "allow-close-status",
    "allow-artifacts-list",
    "allow-export-prepare",
    "allow-export-page",
    "allow-export-save",
    "allow-recording-segments",
    "allow-diagnostics",
    "allow-license-respond"
  ]
}
