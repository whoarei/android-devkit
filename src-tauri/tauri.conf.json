{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Android DevKit",
  "version": "0.1.0",
  "identifier": "dev.android-devkit.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && pnpm notices",
    "devUrl": "http://127.0.0.1:19327",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Android DevKit",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/android-devkit/icon.png", "icons/android-devkit/icon.ico"],
    "resources": {
      "resources/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "resources/third-party-manifest.json": "third-party-manifest.json"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/android-devkit/icon.ico"
      }
    }
  }
}
